{
  "name": "gestao-pneus-node",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema local de gestão de pneus com Node.js, SQL Server, HTML, CSS e JavaScript",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "check": "node scripts/check-syntax.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "verify": "npm run lint && npm run format:check && npm test"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mssql": "^12.7.10",
    "pdfkit": "^0.20.2"
  },
  "optionalDependencies": {
    "msnodesqlv8": "^5.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
