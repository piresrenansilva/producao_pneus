# Configuração do banco — copie este arquivo para .env e ajuste
# (autenticação integrada do Windows = jeito mais simples no uso local)

DB_AUTH=windows
DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server

# SQL Server Express (instância nomeada): preencha DB_INSTANCE e deixe DB_PORT vazio
# SQL Server instância padrão: deixe DB_INSTANCE vazio (usa 1433)
DB_SERVER=localhost
DB_INSTANCE=SQLEXPRESS
DB_PORT=

DB_NAME=FabricaPneus
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true

# Alternativa: connection string para LocalDB. O banco é definido somente em DB_NAME.
# DB_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=(localdb)\MSSQLLocalDB;Trusted_Connection=Yes;Encrypt=No;

# Se preferir login SQL: mude DB_AUTH=sql e preencha abaixo
# DB_AUTH=sql
# DB_USER=sa
# DB_PASSWORD=

# ===== Servidor HTTP =====
# Porta ÚNICA do sistema: 5090 (servidor, navegador e documentação).
# Se o seu .env antigo ainda tiver PORT=5080, troque por 5090 ou apague a linha.
PORT=5090
# Sem HOST (ou HOST=127.0.0.1) o servidor escuta em 127.0.0.1 e ::1,
# garantindo que http://localhost:5090 funcione sempre sem expor para a rede.
# Para acessar de outros computadores: HOST=0.0.0.0 (configure firewall/HTTPS).
HOST=127.0.0.1
# Defina OPEN_BROWSER=false se não quiser que o navegador abra sozinho.
OPEN_BROWSER=true

# ===== Painel DEV (ligar/desligar abas) =====
# Forma rápida: abra http://localhost:5090/dev OU edite dev-flags.json.
# (Opcional) Trava permanente, separando por vírgula:
# MODULOS_DESATIVADOS=relatorios
# (Opcional) Exige chave no painel: use /dev?chave=SUA_CHAVE
# DEV_KEY=

# (Opcional) Tempo limite de conexão com o SQL Server, em milissegundos.
# DB_CONNECT_TIMEOUT=20000
# (Opcional) Force a reexecução completa de schema.sql + migrações no boot.
# FORCE_SCHEMA_CHECK=false

# Deixe vazio para gerar uma chave temporária a cada execução (sessões caem ao reiniciar).
# Em produção (NODE_ENV=production) JWT_KEY é obrigatória e precisa ter >= 32 bytes.
# JWT_KEY=
# JWT_EXPIRES_MINUTES=480
# JWT_ISSUER=FabricaPneus
# JWT_AUDIENCE=FabricaPneusApp
# NODE_ENV=production
