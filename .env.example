# Configuração do banco — copie este arquivo para .env e ajuste
# (autenticação integrada do Windows = jeito mais simples no uso local)

DB_AUTH=windows
DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server

# SQL Server Express (instância nomeada): preencha DB_INSTANCE e deixe DB_PORT vazio
# SQL Server instância padrão: deixe DB_INSTANCE vazio (usa 1433)
DB_SERVER=localhost
DB_INSTANCE=SQLEXPRESS
DB_PORT=

DB_NAME=FabricaPneus
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true

# Alternativa: connection string completa (necessária para LocalDB)
# DB_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=(localdb)\MSSQLLocalDB;Database=FabricaPneus;Trusted_Connection=Yes;Encrypt=No;

# Se preferir login SQL: mude DB_AUTH=sql e preencha abaixo
# DB_AUTH=sql
# DB_USER=sa
# DB_PASSWORD=

HOST=127.0.0.1
PORT=5080

# Deixe vazio para gerar uma chave temporária a cada execução (sessões caem ao reiniciar).
# JWT_KEY=
